{
  "name": "vykor",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:apps": "turbo dev --filter=@vykor/desktop --ui=stream",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types --concurrency=2 && pnpm check-types:server-client",
    "check-docs": "node --test scripts/__test__/documentation-policy.test.mjs && node scripts/check-docs.mjs",
    "check:client-api": "tsc -p tests/client-public-api/tsconfig.json && node --test scripts/forbidden-compatibility-surfaces.test.mjs scripts/architecture-boundaries.test.mjs && pnpm --filter @rzx/client exec vitest run src/__test__/public-api.test.ts",
    "check:architecture": "pnpm check:client-api && node scripts/architecture-boundaries.mjs && pnpm check:clean-slate && pnpm check:retired-ui",
    "check:clean-slate": "node scripts/verify-clean-slate.mjs",
    "check:clean-slate:artifacts": "node scripts/verify-clean-slate.mjs --require-build-artifacts",
    "test": "turbo test --continue=always --concurrency=2 && pnpm test:scripts && pnpm test:execution-integration && pnpm test:agent-integration && pnpm test:desktop-integration && pnpm test:server-client",
    "test:client-browser": "vite build --config tests/browser-client/vite.config.ts",
    "clean": "turbo clean",
    "release:cli": "node scripts/npm-release.mjs",
    "release:cli:dry": "node scripts/npm-release.mjs --dry-run",
    "test:scripts": "node --test scripts/prepare-tag-release.test.mjs scripts/npm-release.test.mjs scripts/release-safety.test.mjs scripts/forbidden-compatibility-surfaces.test.mjs scripts/__test__/prepare-office-engine.test.mjs apps/desktop/scripts/__test__/verify-office-packaging.test.mjs",
    "test:clean-slate": "node --import ./apps/cli/node_modules/tsx/dist/loader.mjs --test scripts/verify-clean-slate.test.mjs scripts/clean-slate-smoke.test.mjs",
    "smoke:clean-slate": "node --import ./apps/cli/node_modules/tsx/dist/loader.mjs scripts/clean-slate-smoke.mjs",
    "prepare": "husky",
    "check:retired-ui": "node --test scripts/check-retired-native-ui.test.mjs && node scripts/check-retired-native-ui.mjs",
    "test:execution-integration": "vitest run --config tests/execution-node/vitest.config.ts",
    "check-types:server-client": "tsc -p tests/server-client/tsconfig.json",
    "test:server-client": "vitest run --config tests/server-client/vitest.config.ts",
    "test:agent-integration": "vitest run --config tests/agent-integration/vitest.config.ts",
    "test:desktop-integration": "vitest run --config tests/desktop-integration/vitest.config.ts",
    "release:client": "node packages/client/scripts/release.mjs",
    "release:client:dry": "node packages/client/scripts/release.mjs --dry-run"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "@types/node": "catalog:",
    "@vykor/agent-contracts": "workspace:*",
    "@vykor/agent-runtime": "workspace:*",
    "@vykor/api": "workspace:*",
    "@rzx/client": "workspace:*",
    "@vykor/coordinator": "workspace:*",
    "@vykor/core": "workspace:*",
    "@vykor/execution-node": "workspace:*",
    "@vykor/host-config": "workspace:*",
    "@vykor/jobs": "workspace:*",
    "@vykor/personalization": "workspace:*",
    "@vykor/plugins": "workspace:*",
    "@vykor/protocol": "workspace:*",
    "@vykor/server": "workspace:*",
    "@vykor/services": "workspace:*",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.12",
    "typescript": "^5.7.3",
    "vite": "^7.3.2",
    "vitest": "^3.1.1",
    "@vykor/tools": "workspace:*",
    "@vykor/permissions": "workspace:*",
    "@vykor/prompts": "workspace:*",
    "@anthropic-ai/sdk": "catalog:",
    "openai": "catalog:",
    "@vykor/application-client": "workspace:*"
  },
  "packageManager": "pnpm@10.30.2"
}
