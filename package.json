{
  "name": "openharness-ts",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:apps": "turbo dev --filter=@openharness/desktop",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "check-docs": "node scripts/check-docs.mjs",
    "check:architecture": "node scripts/architecture-boundaries.mjs",
    "test": "turbo test && node --test scripts/prepare-tag-release.test.mjs scripts/npm-release.test.mjs",
    "test:client-browser": "vite build --config tests/browser-client/vite.config.ts",
    "clean": "turbo clean",
    "release:cli": "node scripts/npm-release.mjs",
    "release:cli:dry": "node scripts/npm-release.mjs --dry-run",
    "test:scripts": "node --test scripts/prepare-tag-release.test.mjs scripts/npm-release.test.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.12",
    "typescript": "^5.7.3",
    "vite": "^7.3.2",
    "vitest": "^3.1.1"
  },
  "packageManager": "pnpm@10.30.2"
}
