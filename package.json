{
  "name": "openharness-ts",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:apps": "turbo dev --filter=@openharness/desktop",
    "build": "turbo build",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "check-docs": "node scripts/check-docs.mjs",
    "check:client-api": "tsc -p tests/client-public-api/tsconfig.json && node --test scripts/forbidden-compatibility-surfaces.test.mjs scripts/architecture-boundaries.test.mjs && pnpm --filter @openharness/client exec vitest run src/__test__/public-api.test.ts",
    "check:architecture": "pnpm check:client-api && node scripts/architecture-boundaries.mjs && pnpm check:clean-slate",
    "check:clean-slate": "node scripts/verify-clean-slate.mjs",
    "check:clean-slate:artifacts": "node scripts/verify-clean-slate.mjs --require-build-artifacts",
    "test": "turbo test && pnpm test:scripts",
    "test:client-browser": "vite build --config tests/browser-client/vite.config.ts",
    "clean": "turbo clean",
    "release:cli": "node scripts/npm-release.mjs",
    "release:cli:dry": "node scripts/npm-release.mjs --dry-run",
    "test:scripts": "node --test scripts/prepare-tag-release.test.mjs scripts/npm-release.test.mjs scripts/release-safety.test.mjs scripts/forbidden-compatibility-surfaces.test.mjs",
    "test:clean-slate": "node --import ./apps/cli/node_modules/tsx/dist/loader.mjs --test scripts/verify-clean-slate.test.mjs scripts/clean-slate-smoke.test.mjs",
    "smoke:clean-slate": "node --import ./apps/cli/node_modules/tsx/dist/loader.mjs scripts/clean-slate-smoke.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "rimraf": "^6.0.1",
    "turbo": "^2.8.12",
    "typescript": "^5.7.3",
    "vite": "^7.3.2",
    "vitest": "^3.1.1"
  },
  "packageManager": "pnpm@10.30.2"
}
