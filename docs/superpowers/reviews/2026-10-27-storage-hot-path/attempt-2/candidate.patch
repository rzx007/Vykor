+import { SessionStore } from "../../session-runtime/store.js";
+import type { StorageContext } from "../../database/storage-context.js";
+
+const cleanups: (() => void)[] = [];
+afterEach(() => cleanups.splice(0).reverse().forEach(cleanup => cleanup()));
+function fixture(storage: "sqlite" | "memory" = "sqlite") {
+  const directory = mkdtempSync(join(tmpdir(), "execution-ensure-"));
+  const store = new SessionStore({ path: join(directory, "store.db") });
+  cleanups.push(() => {
+    const child = relative(resolve(tmpdir()), resolve(directory));
+    if (!child || child.startsWith("..") || isAbsolute(child) || !child.startsWith("execution-ensure-")) throw new Error("Unsafe temporary cleanup");
+    rmSync(directory, { recursive: true, force: true });
+  });
+  cleanups.push(() => store.close());
+  store.sessions.create({ id: "s", cwd: directory, model: "m", storage });
+  store.runs.createRun({ id: "r", sessionId: "s" });
+  return { store, rows: (store as unknown as { storage: StorageContext }).storage.state.executions };
+}
+describe("execution ensure", () => {
+  it("stops at the first matching Run and returns a copy even after that Run ends", () => {
+    const { store, rows } = fixture();
+    const first = store.executions.ensure({ id: "first", sessionId: "s", runId: "r" });
+    store.runs.updateRun("r", { status: "completed" });
+    Object.defineProperty(rows, "unrelated-tail", { configurable: true, enumerable: true, get() { throw new Error("Read past the first execution"); } });
+    try {
+      let copy: typeof first | undefined;
+      expect(() => { copy = store.executions.ensure({ sessionId: "s", runId: "r" }); }).not.toThrow();
+      expect(copy).toMatchObject({ id: "first", status: "completed" });
+      copy!.status = "failed";
+      expect(store.executions.get("first")?.status).toBe("completed");
+    } finally { delete rows["unrelated-tail"]; }
+  });
+  it("checks the first execution identity before any later matching ID", () => {
+    const { store, rows } = fixture();
+    const first = store.executions.ensure({ id: "z-first", sessionId: "s", runId: "r" });
+    rows["a-later"] = { ...first, id: "a-later" };
+    expect(() => store.executions.ensure({ id: "a-later", sessionId: "s", runId: "r" })).toThrow("Execution identity conflict");
+  });
+  it("does not reuse inherited execution records", () => {
+    const { store, rows } = fixture();
+    const prototype = Object.getPrototypeOf(rows);
+    Object.setPrototypeOf(rows, { ghost: { id: "ghost", sessionId: "s", runId: "r", status: "pending" } });
+    try {
+      expect(store.executions.ensure({ id: "own", sessionId: "s", runId: "r" }).id).toBe("own");
+    } finally { Object.setPrototypeOf(rows, prototype); }
+  });
+  it.each(["sqlite", "memory"] as const)("reads newly ensured %s records inside atomic and rolls them back together", storage => {
+    const { store } = fixture(storage);
+    expect(() => store.transaction(() => {
+      const first = store.executions.ensure({ sessionId: "s", runId: "r" });
+      expect(store.executions.ensure({ sessionId: "s", runId: "r" })).toEqual(first);
+      expect(store.executions.list()).toHaveLength(1);
+      throw new Error("abort transaction");
+    })).toThrow("abort transaction");
+    expect(store.executions.list()).toEqual([]);
+    expect(store.executions.ensure({ id: "after-rollback", sessionId: "s", runId: "r" }).id).toBe("after-rollback");
+  });
+});
