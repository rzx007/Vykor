{
  "name": "@vykor/plugin-excalidraw",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#excalidraw/*": "./src/*",
    "#ui/*": "./ui/*",
    "#build/*": "./scripts/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:stdio": "node --test tests/stdio.test.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "1.1.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "@types/node": "^24.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
