{
  "schemaVersion": 1,
  "id": "vykor.knowledge-work",
  "name": "knowledge-work",
  "displayName": "研究与写作",
  "version": "1.1.1",
  "description": "基于网页和用户资料生成可追溯的研究报告、完整稿件，并继续修改当前成果。",
  "icon": "data:image/svg+xml;base64,",
  "introduction": "## 从资料到有据可查的成果\n\n研究与写作插件帮助你调研主题、核对来源、整理证据并撰写稿件。研究助手可以比较资料并标注出处；写作助手可以把报告整理成文章，也可以继续修改现有稿件。\n\n网页资料通过应用现有的网页读取能力获取；学术检索仅访问插件声明的学术 API。引用与覆盖检查用于发现遗漏，不代表结论已经得到证明。插件不会自动发布内容；需要读取或写入文件时，仍按应用的现有权限流程执行。",
  "prompts": [
    {
      "title": "调研一个主题",
      "prompt": "请调研这个主题，比较可靠来源中的主要观点与分歧，并交付带出处、日期和限制说明的报告：\n\n在这里填写主题"
    },
    {
      "title": "把报告写成文章",
      "prompt": "请阅读我提供的研究报告和来源，检查关键说法的证据覆盖，再写成面向目标读者的完整文章；保留出处和限制：\n\n在这里填写目标读者与风格"
    },
    {
      "title": "继续修改当前稿件",
      "prompt": "请在保留当前稿件事实边界和已有手工修改的前提下，完成这项调整：\n\n在这里说明修改要求"
    }
  ],
  "license": "MIT",
  "keywords": ["research", "writing", "研究", "写作"],
  "components": {
    "agents": ["./agents"],
    "skills": ["./skills"],
    "tools": [
      { "entry": "./tools/index.mjs", "runtime": "node", "permissions": ["filesystem:read"] },
      { "entry": "./tools/source-records.mjs", "runtime": "node", "permissions": ["filesystem:read", "filesystem:write"] },
      { "entry": "./tools/academic.mjs", "runtime": "node", "permissions": ["filesystem:write", "network:export.arxiv.org", "network:api.openalex.org", "network:api.crossref.org", "network:api.semanticscholar.org", "network:eutils.ncbi.nlm.nih.gov"] }
    ]
  },
  "permissions": { "filesystem": ["read", "write"], "network": ["export.arxiv.org", "api.openalex.org", "api.crossref.org", "api.semanticscholar.org", "eutils.ncbi.nlm.nih.gov"] },
  "runtime": { "engine": "node", "isolation": "process" }
}
