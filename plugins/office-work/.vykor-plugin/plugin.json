{
  "schemaVersion": 1,
  "id": "vykor.office-work",
  "name": "office-work",
  "displayName": "演示文稿",
  "version": "0.2.0",
  "description": "创建、读取和局部修改可编辑 PPTX，检查文件结构。首版支持 Windows x64，视觉效果需在 PowerPoint 或 WPS 中查看。",
  "icon": "data:image/svg+xml;base64,",
  "license": "MIT",
  "prompts": [
    {"title":"把报告变成 PPT","prompt":"请读取我指定的报告，制作一份 6 页可编辑 PPTX，保留来源与证据限制。保存到 office-work/，完成后检查结构并告诉我实际文件路径。"},
    {"title":"修改已有 PPT","prompt":"请先读取我指定的 PPTX，按具体元素路径进行局部修改；保留源文件，不改无关页面。完成后检查结构并交付工作副本。"}
  ],
  "components": {
    "agents": ["./agents"],
    "skills": ["./skills"],
    "tools": [{"entry":"./tools/index.mjs","runtime":"node","permissions":["filesystem:read","filesystem:write","process:officecli"]}]
  },
  "permissions":{"filesystem":["read","write"],"process":["officecli"]},
  "runtime":{"engine":"node","isolation":"process"}
}
