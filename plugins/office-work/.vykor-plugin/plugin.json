{
  "schemaVersion": 1,
  "id": "vykor.office-work",
  "name": "office-work",
  "displayName": "办公文档",
  "version": "0.7.2",
  "description": "创建、读取和局部修改 DOCX 报告与 PPTX，支持表格、HTML 截图和版本绑定检查记录；复杂排版需在 Office/WPS 中验收。",
  "icon": "data:image/svg+xml;base64,",
  "license": "MIT",
  "prompts": [
    {
      "title": "把报告变成 Word",
      "prompt": "请读取我指定的调研报告，生成可编辑 DOCX，使用清楚的章节标题，保留来源与证据限制。保存到新的 office-work/ 输出目录，完成后检查结构并交付实际路径。"
    },
    {
      "title": "把报告变成 PPT",
      "prompt": "请读取我指定的报告，制作一份 6 页可编辑 PPTX，保留来源与证据限制。保存到 office-work/，完成后检查结构并告诉我实际文件路径。"
    },
    {
      "title": "修改已有 PPT",
      "prompt": "请先读取我指定的 PPTX，按具体元素路径进行局部修改；保留源文件，不改无关页面。完成后检查结构并交付工作副本。"
    }
  ],
  "components": {
    "agents": [
      "./agents"
    ],
    "skills": [
      "./skills"
    ],
    "tools": [
      {
        "entry": "./tools/index.mjs",
        "runtime": "node",
        "permissions": [
          "filesystem:read",
          "filesystem:write",
          "process:officecli"
        ]
      }
    ]
  },
  "permissions": {
    "filesystem": [
      "read",
      "write"
    ],
    "process": [
      "officecli"
    ]
  },
  "runtime": {
    "engine": "node",
    "isolation": "process"
  }
}
