{
  "schemaVersion": 1,
  "id": "vykor.office-work",
  "name": "office-work",
  "displayName": "办公文档",
  "version": "0.12.3",
  "description": "创建、读取或修改 Word、Excel、PPT 时，先加载 office-work-entry 接入 Skill，再使用官方技能与插件 OfficeCLI 工具；不通过 Shell 调用全局引擎。",
  "icon": "data:image/svg+xml;base64,",
  "license": "MIT",
  "prompts": [
    {
      "title": "制作 Excel 报表",
      "prompt": "请根据我提供的资料生成可编辑 XLSX 报表，保留来源、单位和公式，保存到新的 office-work/ 输出目录；检查公式与结构，并实际查看需要的区域后交付。"
    },
    {
      "title": "把报告变成 Word",
      "prompt": "请读取我指定的调研报告，生成可编辑 DOCX，使用清楚的章节标题，保留来源与证据限制。保存到新的 office-work/ 输出目录，完成后检查结构并交付实际路径。"
    },
    {
      "title": "把报告变成 PPT",
      "prompt": "请读取我指定的报告，制作一份 6 页可编辑 PPTX，保留来源与证据限制。保存到 office-work/，完成后检查结构并告诉我实际文件路径。"
    },
    {
      "title": "修改已有 PPT",
      "prompt": "请先读取我指定的 PPTX，按具体元素路径进行局部修改；保留源文件，不改无关页面。完成后检查结构并交付工作副本。"
    }
  ],
  "components": {
    "agents": [
      "./agents"
    ],
    "skills": [
      "./skills/office-work-entry",
      "./vendor/officecli/skills"
    ],
    "tools": [
      {
        "entry": "./tools/index.mjs",
        "runtime": "node",
        "permissions": [
          "filesystem:read",
          "filesystem:write",
          "process:officecli"
        ]
      }
    ]
  },
  "permissions": {
    "filesystem": [
      "read",
      "write"
    ],
    "process": [
      "officecli"
    ]
  },
  "runtime": {
    "engine": "node",
    "isolation": "process"
  }
}
