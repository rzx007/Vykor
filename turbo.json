{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["vitest.config.ts", "tests/setup-isolated-host.ts", "tests/helpers/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@vykor/desktop#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@vykor/desktop#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["out/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@vykor/plugins#test": {
      "dependsOn": ["^build"],
      "env": ["VYKOR_OFFICIAL_PLUGINS_DIR"],
      "cache": false
    },
    "@vykor/agent-runtime#test": {
      "dependsOn": ["^build"],
      "env": ["VYKOR_OFFICIAL_PLUGINS_DIR"],
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/examples/plugins/text-inspector/**"]
    },
    "@vykor/server#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/plugins/text-inspector/**",
        "$TURBO_ROOT$/packages/client/src/**",
        "$TURBO_ROOT$/packages/application-client/src/**",
        "$TURBO_ROOT$/packages/agent-runtime/test-helpers/**"
      ]
    },
    "@vykor/desktop#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/plugins/text-inspector/**",
        "$TURBO_ROOT$/packages/plugin-sources/src/**",
        "$TURBO_ROOT$/packages/plugins/src/**",
        "$TURBO_ROOT$/packages/server/src/application/default-services/extensions/plugin-service.ts",
        "$TURBO_ROOT$/packages/server/src/http/routes/service.ts",
        "$TURBO_ROOT$/packages/client/src/**",
        "$TURBO_ROOT$/packages/application-client/src/**"
      ]
    },
    "@vykor/plugins#check-types": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/plugins/text-inspector/**",
        "$TURBO_ROOT$/examples/plugins/notes-app/**",
        "$TURBO_ROOT$/skills/create-plugin/templates/weather-travel/**",
        "$TURBO_ROOT$/skills/create-plugin/assets/text-inspector/**",
        "$TURBO_ROOT$/scripts/sync-plugin-app-client.mjs"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
