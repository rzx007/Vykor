{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": ["vitest.config.ts", "tests/setup-isolated-host.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@vykor/desktop#dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@vykor/desktop#build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/plugins/knowledge-work/**"],
      "outputs": ["out/**"]
    },
    "check-types": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@vykor/agent-runtime#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/examples/plugins/text-inspector/**", "$TURBO_ROOT$/plugins/knowledge-work/**"]
    },
    "@vykor/server#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/plugins/text-inspector/**",
        "$TURBO_ROOT$/packages/client/src/**",
        "$TURBO_ROOT$/packages/agent-runtime/test-helpers/**"
      ]
    },
    "@vykor/desktop#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/examples/plugins/text-inspector/**",
        "$TURBO_ROOT$/plugins/knowledge-work/**",
        "$TURBO_ROOT$/packages/plugin-sources/src/**",
        "$TURBO_ROOT$/packages/plugins/src/**",
        "$TURBO_ROOT$/packages/server/src/application/default-services/plugin-service.ts",
        "$TURBO_ROOT$/packages/server/src/http/routes/service.ts",
        "$TURBO_ROOT$/packages/client/src/transport/http-client.ts",
        "$TURBO_ROOT$/packages/client/src/types/index.ts"
      ]
    },
    "@vykor/plugins#check-types": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/examples/plugins/text-inspector/**", "$TURBO_ROOT$/plugins/knowledge-work/**"]
    },
    "clean": {
      "cache": false
    }
  }
}
