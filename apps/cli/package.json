{
  "name": "@rzx/ohs",
  "version": "1.0.0",
  "description": "OpenHarness terminal CLI — interactive TUI and headless agent for your codebase",
  "type": "module",
  "bin": {
    "ohs": "./dist/index.js",
    "openharness": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "openharness",
    "cli",
    "ai",
    "agent",
    "tui",
    "llm",
    "coding-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzx007/openharness-ts.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/rzx007/openharness-ts/tree/main/apps/cli",
  "bugs": {
    "url": "https://github.com/rzx007/openharness-ts/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "bun run build.ts",
    "dev": "bun --watch src/index.ts",
    "check-types": "tsc --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentui/core": "catalog:",
    "@opentui/react": "catalog:",
    "better-sqlite3": "^13.0.2",
    "chalk": "catalog:",
    "commander": "catalog:",
    "diff": "catalog:",
    "node-pty": "^1.0.0",
    "qrcode-terminal": "^0.12.0",
    "react": "catalog:",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@openharness/agent-runtime": "workspace:*",
    "@openharness/api": "workspace:*",
    "@openharness/auth": "workspace:*",
    "@openharness/channels": "workspace:*",
    "@openharness/client": "workspace:*",
    "@openharness/commands": "workspace:*",
    "@openharness/coordinator": "workspace:*",
    "@openharness/core": "workspace:*",
    "@openharness/hooks": "workspace:*",
    "@openharness/mcp": "workspace:*",
    "@openharness/memory": "workspace:*",
    "@openharness/output-styles": "workspace:*",
    "@openharness/permissions": "workspace:*",
    "@openharness/personalization": "workspace:*",
    "@openharness/plugins": "workspace:*",
    "@openharness/plugin-converters": "workspace:*",
    "@openharness/prompts": "workspace:*",
    "@openharness/sandbox": "workspace:*",
    "@openharness/server": "workspace:*",
    "@openharness/services": "workspace:*",
    "@openharness/skills": "workspace:*",
    "@openharness/themes": "workspace:*",
    "@openharness/tools": "workspace:*",
    "@types/node": "catalog:",
    "@types/bun": "^1.3.14",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "catalog:"
  }
}
