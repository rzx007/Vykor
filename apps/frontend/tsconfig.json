{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "paths": {
      "@vykor/coordinator/definitions": [
        "../../packages/coordinator/src/definitions/index.ts"
      ],
      "@vykor/coordinator/teams": [
        "../../packages/coordinator/src/teams/index.ts"
      ],
      "@vykor/coordinator/workflow": [
        "../../packages/coordinator/src/workflow/index.ts"
      ],
      "@vykor/application-client": [
        "../../packages/application-client/src/index.ts"
      ],
      "@vykor/services": [
        "../../packages/services/src/index.ts"
      ],
      "@vykor/core": [
        "../../packages/core/src/index.ts"
      ],
      "@vykor/memory": [
        "../../packages/memory/src/index.ts"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
