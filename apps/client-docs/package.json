{
  "name": "@vykor/client-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vykor Client SDK documentation, examples and generated API reference",
  "engines": { "node": ">=22.23.4" },
  "scripts": {
    "prepare:sdk": "pnpm --filter @rzx/client build",
    "dev": "astro dev",
    "build": "pnpm run check:examples && astro build && pnpm run check:site",
    "preview": "astro preview",
    "check-types": "astro sync && astro-check && pnpm run check:examples",
    "check:examples": "tsc -p examples/tsconfig.json --noEmit && tsc -p examples/browser/tsconfig.json --noEmit",
    "check:site": "node scripts/check-site.mjs",
    "test": "node --test scripts/__test__/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/starlight": "0.42.7",
    "astro": "7.4.4",
    "starlight-typedoc": "0.23.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@emnapi/runtime": "1.11.3",
    "@rzx/client": "workspace:*",
    "@types/node": "catalog:",
    "parse5": "8.0.0",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.14.1",
    "typescript": "^5.7.3"
  }
}
