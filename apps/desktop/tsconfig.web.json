{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/document-preview/**/*",
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/components/primitives/TaskRows.tsx",
    "src/preload/*.d.ts",
    "src/shared/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@vykor/coordinator/definitions": [
        "../../packages/coordinator/src/definitions/index.ts"
      ],
      "@vykor/coordinator/teams": [
        "../../packages/coordinator/src/teams/index.ts"
      ],
      "@vykor/coordinator/workflow": [
        "../../packages/coordinator/src/workflow/index.ts"
      ],
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@main/*": [
        "src/main/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
