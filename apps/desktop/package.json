{
  "name": "@vykor/desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Vykor desktop application",
  "main": "./out/main/index.js",
  "author": "Vykor",
  "homepage": "https://github.com/rzx007/Vykor",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run && node --test scripts/verify-migration-artifact.test.mjs && node scripts/verify-update-packaging.mjs && node scripts/verify-workspace-boundaries.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "node scripts/verify-workspace-boundaries.mjs && pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "verify:attachment-ocr": "node scripts/verify-attachment-ocr-packaging.mjs",
    "verify:attachment-ocr:artifact": "node scripts/verify-attachment-ocr-packaging.mjs --artifact",
    "verify:update-packaging": "node scripts/verify-update-packaging.mjs",
    "verify:update-packaging:artifact": "node scripts/verify-update-packaging.mjs --artifact"
  },
  "dependencies": {
    "@arcships/light-ocr": "catalog:",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@streamdown/cjk": "1.0.3",
    "better-sqlite3": "^13.0.2",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "node-pty": "^1.0.0",
    "qrcode": "^1.5.4",
    "sharp": "0.34.4"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@blobatar/react": "^2.5.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/asar": "^3.4.1",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lexical/react": "^0.49.0",
    "@lobehub/icons": "^5.16.0",
    "@vykor/client": "workspace:*",
    "@vykor/server": "workspace:*",
    "@pierre/diffs": "^1.3.5",
    "@pierre/trees": "1.0.0-beta.6",
    "@shadcn/react": "^0.3.0",
    "@tabler/icons-react": "^3.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@tanstack/router-plugin": "^1.168.30",
    "@types/node": "^22.19.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "beautiful-mermaid": "^1.1.3",
    "blobatar": "^2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-store": "^11.0.2",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^30.0.1",
    "jszip": "^3.10.1",
    "lexical": "^0.49.0",
    "liquid-gooey": "^0.1.0",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-resizable-panels": "4.12.2",
    "shadcn": "^4.18.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tinykeys": "^4.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^7.2.6",
    "yaml": "catalog:",
    "zod": "catalog:",
    "zustand": "^5.0.15"
  }
}
