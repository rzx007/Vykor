{
  "name": "@rzx/client",
  "version": "0.1.0",
  "type": "module",
  "description": "Browser-compatible Vykor HTTP and event client with Node.js local service management",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzx007/Vykor.git",
    "directory": "packages/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "pnpm run build",
    "test:pack": "pnpm run verify:pack",
    "verify:pack": "node scripts/verify-pack.mjs",
    "check-types": "tsc --noEmit",
    "test": "node --test scripts/__test__/release.test.mjs && vitest run",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/proper-lockfile": "4.1.4",
    "@vykor/protocol": "workspace:*",
    "esbuild": "0.27.7",
    "proper-lockfile": "4.1.2",
    "rollup": "4.60.1",
    "rollup-plugin-dts": "6.3.0",
    "typescript": "^5.7.3",
    "vitest": "catalog:"
  }
}
