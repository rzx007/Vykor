{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "@vykor/coordinator/definitions": [
        "../coordinator/src/definitions/index.ts"
      ],
      "@vykor/coordinator/teams": [
        "../coordinator/src/teams/index.ts"
      ],
      "@vykor/coordinator/workflow": [
        "../coordinator/src/workflow/index.ts"
      ],
      "@vykor/core": [
        "../core/src/index.ts"
      ],
      "@vykor/memory": [
        "../memory/src/index.ts"
      ],
      "@vykor/services": [
        "../services/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ]
}
