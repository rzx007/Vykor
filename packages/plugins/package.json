{
  "name": "@vykor/plugins",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./sdk": {
      "types": "./src/sdk.ts"
    },
    "./app-client": {
      "types": "./src/app-client/client.ts",
      "import": "./src/app-client/client.ts"
    }
  },
  "scripts": {
    "build": "exit 0",
    "check-types": "tsc --noEmit && tsc -p tsconfig.sdk-tests.json && tsc -p tsconfig.sdk-examples.json && tsc -p tsconfig.app-client-tests.json && node ../../scripts/sync-plugin-app-client.mjs --check",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "zod": "catalog:",
    "@vykor/skills": "workspace:*",
    "@vykor/coordinator": "workspace:*",
    "@vykor/agent-contracts": "workspace:*",
    "@vykor/host-config": "workspace:*",
    "@vykor/plugin-contracts": "workspace:*",
    "@vykor/json-data": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "^5.7.3",
    "vitest": "catalog:"
  }
}
