{
  "name": "@vykor/agent-runtime",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel-entry.d.ts",
      "import": "./dist/kernel.js"
    },
    "./node/workflow": {
      "types": "./dist/workflow-entry.d.ts",
      "import": "./dist/workflow.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/build.mjs",
    "test:pack": "pnpm run build && node scripts/verify-pack.mjs",
    "check-types": "tsc --noEmit",
    "test": "node --test scripts/kernel-boundary.test.mjs && vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@vykor/terminal-node": "workspace:*",
    "node-pty": "^1.0.0",
    "sharp": "0.34.4",
    "@vykor/agent-contracts": "workspace:*",
    "@vykor/host-config": "workspace:*",
    "@vykor/execution-node": "workspace:*",
    "@vykor/api": "workspace:*",
    "@vykor/auth": "workspace:*",
    "@vykor/coordinator": "workspace:*",
    "@vykor/core": "workspace:*",
    "@vykor/environment": "workspace:*",
    "@vykor/hooks": "workspace:*",
    "@vykor/jobs": "workspace:*",
    "@vykor/mcp": "workspace:*",
    "@vykor/memory": "workspace:*",
    "@vykor/permissions": "workspace:*",
    "@vykor/plugins": "workspace:*",
    "@vykor/prompts": "workspace:*",
    "@vykor/sandbox": "workspace:*",
    "@vykor/skills": "workspace:*",
    "@vykor/terminal": "workspace:*",
    "@vykor/tools": "workspace:*",
    "@types/node": "catalog:",
    "@vykor/plugin-contracts": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "typescript": "^5.7.3",
    "vitest": "catalog:"
  }
}
