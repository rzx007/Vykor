{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vykor.dev/schemas/client-public-api-contract.schema.json",
  "title": "Current @vykor/client public API",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "entries"],
  "properties": {
    "$schema": { "const": "./client-public-api-contract.schema.json" },
    "version": { "const": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["runtime-export", "type-export", "client-resource"]
          }
        }
      }
    }
  }
}
