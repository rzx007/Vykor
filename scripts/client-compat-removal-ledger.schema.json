{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "client-compat-removal-ledger.schema.json",
  "type": "object",
  "required": ["version", "repository", "baseline", "carrier", "releases", "authorization", "removal"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "repository": { "const": "rzx007/openharness-ts" },
    "baseline": {
      "type": "object",
      "required": ["stage7Commit", "methodCount", "methodsSha256", "methods"],
      "properties": {
        "stage7Commit": { "$ref": "#/$defs/commit" },
        "methodCount": { "type": "integer", "minimum": 1 },
        "methodsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "replacement"],
            "properties": {
              "name": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$" },
              "replacement": { "type": "string", "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*\\.[A-Za-z_$][A-Za-z0-9_$]*$" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "carrier": {
      "type": "object",
      "required": ["package", "channel"],
      "properties": {
        "package": { "const": "@rzx/ohs" },
        "channel": { "const": "stable" }
      },
      "additionalProperties": false
    },
    "releases": {
      "type": "object",
      "required": ["deprecation", "retention"],
      "properties": {
        "deprecation": { "$ref": "#/$defs/releaseEvidence" },
        "retention": { "$ref": "#/$defs/releaseEvidence" }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": ["status", "targetVersion", "authorizedAt", "baselineSha256", "evidenceSha256"],
      "properties": {
        "status": { "enum": ["pending", "ready", "consumed"] },
        "targetVersion": { "type": ["string", "null"] },
        "authorizedAt": { "type": ["string", "null"] },
        "baselineSha256": { "type": ["string", "null"] },
        "evidenceSha256": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "removal": {
      "type": "object",
      "required": ["status", "commit"],
      "properties": {
        "status": { "enum": ["not-started", "removed"] },
        "commit": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/commit" }] }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "releaseEvidence": {
      "oneOf": [
        { "const": "pending" },
        {
          "type": "object",
          "required": ["carrier", "version", "tag", "commit", "publishedAt", "channel", "releaseNoteUrl", "workflowRunUrl", "npm"],
          "properties": {
            "carrier": { "const": "@rzx/ohs" },
            "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
            "tag": { "type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
            "commit": { "$ref": "#/$defs/commit" },
            "publishedAt": { "type": "string", "format": "date-time" },
            "channel": { "const": "stable" },
            "releaseNoteUrl": { "type": "string", "format": "uri" },
            "workflowRunUrl": { "type": "string", "format": "uri" },
            "npm": {
              "type": "object",
              "required": ["package", "version", "verified"],
              "properties": {
                "package": { "const": "@rzx/ohs" },
                "version": { "type": "string" },
                "verified": { "const": true }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
